{"lines": [{"s": "ANNA", "t": "Is Mia your new coworker?", "start": 0.0, "end": 2.14}, {"s": "BEN", "t": "Yes, she is. She works in sales.", "start": 2.56, "end": 7.02}, {"s": "ANNA", "t": "Does she work with your team?", "start": 7.44, "end": 9.48}, {"s": "BEN", "t": "Yes, she does. She works in our office.", "start": 9.9, "end": 14.44}, {"s": "ANNA", "t": "Is she friendly?", "start": 14.86, "end": 16.73}, {"s": "BEN", "t": "Yes, she is. Her teammates are friendly too.", "start": 17.15, "end": 21.95}, {"s": "ANNA", "t": "Are they busy today?", "start": 22.37, "end": 24.24}, {"s": "BEN", "t": "No, they aren’t. They have time for lunch.", "start": 24.66, "end": 29.08}, {"s": "ANNA", "t": "Do they eat lunch together?", "start": 29.5, "end": 31.58}, {"s": "BEN", "t": "Yes, they do. They eat at the café nearby.", "start": 32.0, "end": 36.71}]}