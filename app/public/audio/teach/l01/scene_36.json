{"lines": [{"s": "ANNA", "t": "Hi, I’m Anna. Are you new here?", "start": 0.0, "end": 3.19}, {"s": "BEN", "t": "Yes, I am. I’m a little nervous.", "start": 3.61, "end": 7.72}, {"s": "ANNA", "t": "Me too. Do you live near here?", "start": 8.14, "end": 10.92}, {"s": "BEN", "t": "No, I don’t. I live near the beach.", "start": 11.34, "end": 15.49}, {"s": "ANNA", "t": "Do you work on Saturdays?", "start": 15.91, "end": 17.98}, {"s": "BEN", "t": "Yes, I do. I work in a shop.", "start": 18.4, "end": 22.6}, {"s": "ANNA", "t": "Do you practice English at home?", "start": 23.02, "end": 25.39}, {"s": "BEN", "t": "Yes, I do. I practice after work.", "start": 25.81, "end": 30.32}, {"s": "ANNA", "t": "Are you ready for class?", "start": 30.74, "end": 32.64}, {"s": "BEN", "t": "Yes, I am. Let’s go.", "start": 33.06, "end": 36.71}]}