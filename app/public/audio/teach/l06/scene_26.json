 "lines": [
  {
   "s": "",
   "t": "Do you know this restaurant, Leo?",
   "start": 0,
   "end": 1.36
  },
  {
   "s": "",
   "t": "No. Is it new?",
   "start": 1.86,
   "end": 3.12
  },
  {
   "s": "",
   "t": "Yes. It’s my new favorite place for lunch.",
   "start": 3.52,
   "end": 6.46
  },
  {
   "s": "",
   "t": "Does it serve local food?",
   "start": 6.94,
   "end": 8.1
  },
  {
   "s": "",
   "t": "Yes, and the prices are good.",
   "start": 8.44,
   "end": 10.26
  },
  {
   "s": "",
   "t": "What about those small shops next to it?",
   "start": 10.66,
   "end": 12.66
  },
  {
   "s": "",
   "t": "They sell local food too. Is that tall building a hotel?",
   "start": 12.92,
   "end": 16.08
  },
  {
   "s": "",
   "t": "Yes, it is. My friend works at that hotel.",
   "start": 16.62,
   "end": 19.12
  },
  {
   "s": "",
   "t": "Is her hotel nice?",
   "start": 19.6,
   "end": 20.46
  },
  {
   "s": "",
   "t": "Yes, it is. Let’s visit her after lunch.",
   "start": 20.96,
   "end": 23.58
  }
