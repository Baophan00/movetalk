{
  "title": "Point, Ask & Connect",
  "vi": "Chỉ, hỏi và kết nối",
  "goal": "By the end of this lesson, you can use this/that/these/those + is/are to point at things, ask Yes-No questions, and keep a conversation going with follow-ups.",
  "today": [
    "Review noun phrases from L04",
    "Learn this/that/these/those + is/are",
    "Practice Is this…? / Are these…?",
    "Build short conversations"
  ],
  "parts": {
    "vocab": [
      {
        "t": "h",
        "text": "Pointing & asking"
      },
      {
        "t": "flashcard",
        "items": [
          {
            "word": "this",
            "phonetic": "/ðɪs/",
            "vi": "này (gần, 1)",
            "def": "points to one thing near you",
            "examples": [
              {
                "text": "Is this your phone?",
                "context": "daily"
              },
              {
                "text": "This is my new laptop.",
                "context": "work"
              }
            ]
          },
          {
            "word": "that",
            "phonetic": "/ðæt/",
            "vi": "kia (xa, 1)",
            "def": "points to one thing far from you",
            "examples": [
              {
                "text": "Is that your hotel?",
                "context": "daily"
              },
              {
                "text": "That is a nice café.",
                "context": "daily"
              }
            ]
          },
          {
            "word": "these",
            "phonetic": "/ðiz/",
            "vi": "này (gần, nhiều)",
            "def": "points to many things near you",
            "examples": [
              {
                "text": "Are these your keys?",
                "context": "daily"
              },
              {
                "text": "These are my new coworkers.",
                "context": "work"
              }
            ]
          },
          {
            "word": "those",
            "phonetic": "/ðoʊz/",
            "vi": "kia (xa, nhiều)",
            "def": "points to many things far from you",
            "examples": [
              {
                "text": "Are those your coworkers?",
                "context": "work"
              },
              {
                "text": "Those are our client files.",
                "context": "work"
              }
            ]
          },
          {
            "word": "first time",
            "phonetic": "/fɜrst taɪm/",
            "vi": "lần đầu tiên",
            "def": "the first occasion you do something",
            "examples": [
              {
                "text": "Is this your first time here?",
                "context": "daily"
              },
              {
                "text": "This is my first time working with a foreign client.",
                "context": "work"
              }
            ]
          },
          {
            "word": "across the street",
            "phonetic": "/əˈkrɔs ðə strit/",
            "vi": "bên kia đường",
            "def": "on the other side of the road",
            "examples": [
              {
                "text": "That's my hotel across the street.",
                "context": "daily"
              },
              {
                "text": "The office is across the street.",
                "context": "work"
              }
            ]
          },
          {
            "word": "over there",
            "phonetic": "/ˈoʊvər ðer/",
            "vi": "ở đằng kia",
            "def": "in that place, far from you",
            "examples": [
              {
                "text": "Those are my coworkers over there.",
                "context": "work"
              },
              {
                "text": "The café is over there.",
                "context": "daily"
              }
            ]
          },
          {
            "word": "so far",
            "phonetic": "/soʊ fɑr/",
            "vi": "cho đến bây giờ",
            "def": "until now",
            "examples": [
              {
                "text": "How do you like it so far?",
                "context": "daily"
              },
              {
                "text": "The project is going well so far.",
                "context": "work"
              }
            ]
          },
          {
            "word": "follow-up",
            "phonetic": "/ˈfɑloʊ ʌp/",
            "vi": "câu hỏi tiếp theo",
            "def": "a question that continues the conversation",
            "examples": [
              {
                "text": "Can I ask a follow-up question?",
                "context": "work"
              },
              {
                "text": "That's a good follow-up.",
                "context": "daily"
              }
            ]
          }
        ]
      },
      {
        "t": "note",
        "text": "Choose two people. Say who they are and one thing you like or dislike about them. Accept simple language — ask one follow-up: How do you know them? or What are they like?"
      }
    ],
    "grammar": [
      {
        "t": "h",
        "text": "The pointing system"
      },
      {
        "t": "table",
        "head": [
          "Distance",
          "Number",
          "Word",
          "BE",
          "Question"
        ],
        "rows": [
          [
            "Near",
            "One",
            "this",
            "is",
            "Is this…?"
          ],
          [
            "Far",
            "One",
            "that",
            "is",
            "Is that…?"
          ],
          [
            "Near",
            "Many",
            "these",
            "are",
            "Are these…?"
          ],
          [
            "Far",
            "Many",
            "those",
            "are",
            "Are those…?"
          ]
        ]
      },
      {
        "t": "h",
        "text": "Yes-No question engine — flip BE to the front"
      },
      {
        "t": "table",
        "head": [
          "Statement",
          "Question",
          "Answer"
        ],
        "rows": [
          [
            "This is your phone.",
            "Is this your phone?",
            "Yes, it is. / No, it isn't."
          ],
          [
            "That is the meeting room.",
            "Is that the meeting room?",
            "Yes, it is. / No, it isn't."
          ],
          [
            "These are your keys.",
            "Are these your keys?",
            "Yes, they are. / No, they aren't."
          ],
          [
            "Those are our seats.",
            "Are those our seats?",
            "Yes, they are. / No, they aren't."
          ]
        ]
      },
      {
        "t": "note",
        "text": "IS + THIS/THAT · ARE + THESE/THOSE. No DO or DOES needed."
      },
      {
        "t": "h",
        "text": "Answer & add — one → it, many → they"
      },
      {
        "t": "table",
        "head": [
          "Question",
          "Short answer",
          "Full message"
        ],
        "rows": [
          [
            "Is this your laptop?",
            "Yes, it is.",
            "This is my work laptop."
          ],
          [
            "Is that your manager?",
            "No, it isn't.",
            "That's our new client."
          ],
          [
            "Are these your files?",
            "Yes, they are.",
            "These are today's reports."
          ],
          [
            "Are those your seats?",
            "No, they aren't.",
            "Those are reserved seats."
          ]
        ]
      }
    ],
    "reading": [
      {
        "t": "h",
        "text": "Model answer · A complete turn"
      },
      {
        "t": "p",
        "text": "This is my first morning in Da Nang. That's a small café across from my hotel. This is a good place to start the day, and that's an amazing view of the river. These are my travel notes, and those are my work files. A woman at the next table asks, 'Is this your first time here?' I say yes, and we start talking about the city."
      },
      {
        "t": "note",
        "text": "Notice: this is…, that's…, these are…, those are…. The demonstrative + BE + information pattern."
      }
    ],
    "conversations": [
      {
        "t": "dialog",
        "title": "First time here",
        "target": "Is this your first time…?",
        "lift": "Yes–No opens the door. Follow-up keeps it open.",
        "lines": [
          {
            "speaker": "A",
            "text": "Is this your first time here?"
          },
          {
            "speaker": "B",
            "text": "Yes, it is."
          },
          {
            "speaker": "A",
            "text": "How do you like it so far?"
          },
          {
            "speaker": "B",
            "text": "I really like it."
          },
          {
            "speaker": "A",
            "text": "Are you here for work?"
          },
          {
            "speaker": "B",
            "text": "No, I'm here on vacation."
          },
          {
            "speaker": "A",
            "text": "Is this your first day in the city?"
          },
          {
            "speaker": "B",
            "text": "Yes. I arrived this morning."
          },
          {
            "speaker": "A",
            "text": "Do you have any plans for today?"
          },
          {
            "speaker": "B",
            "text": "Yes. I'm visiting the beach."
          }
        ],
        "check": [
          "Is it B's first time here?",
          "Is B here for work?",
          "What are B's plans?"
        ],
        "answers": "1. Yes. 2. No, vacation. 3. The beach.",
        "note": "Follow the last answer. Don't jump to a new topic."
      },
      {
        "t": "dialog",
        "title": "At the office",
        "target": "Is this your desk? · Are those…?",
        "lift": "point → ask → connect",
        "lines": [
          {
            "speaker": "A",
            "text": "Is this your desk?"
          },
          {
            "speaker": "B",
            "text": "Yes, it is."
          },
          {
            "speaker": "A",
            "text": "Is that your laptop bag?"
          },
          {
            "speaker": "B",
            "text": "Yes. And those are my work files."
          },
          {
            "speaker": "A",
            "text": "Are those your coworkers over there?"
          },
          {
            "speaker": "B",
            "text": "No. Those aren't my coworkers."
          },
          {
            "speaker": "A",
            "text": "Are they from your tour group?"
          },
          {
            "speaker": "B",
            "text": "No. I think they're from another team."
          }
        ],
        "check": [
          "Is it B's desk?",
          "Are those B's coworkers?",
          "Whose files are they?"
        ],
        "answers": "1. Yes. 2. No. 3. B's work files.",
        "note": "this/that = one. these/those = many. Then BE: is/are."
      },
      {
        "t": "dialog",
        "title": "Travel morning in Da Nang",
        "target": "That's a… · This is a…",
